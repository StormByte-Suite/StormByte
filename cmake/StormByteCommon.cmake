function(_stormbyte_library_is_shared library out)
	if(WIN32 AND ARGC GREATER 2)
		set(_override_variable "${ARGV2}")
		if(DEFINED ${_override_variable})
			string(TOUPPER "${${_override_variable}}" _override)
			if(_override MATCHES "^(ON|TRUE|YES|Y|1)$")
				set(${out} TRUE PARENT_SCOPE)
			elseif(_override MATCHES "^(OFF|FALSE|NO|N|0)$")
				set(${out} FALSE PARENT_SCOPE)
			else()
				message(FATAL_ERROR "${_override_variable} must be a boolean, got '${${_override_variable}}'")
			endif()
			return()
		endif()
	endif()
	set(_shared FALSE)
	if(library MATCHES "\\.so($|\\.)|\\.dylib$")
		set(_shared TRUE)
	elseif(WIN32)
		string(TOLOWER "${library}" _lower_library)
		if(_lower_library MATCHES "\\.dll\\.a$")
			set(_shared TRUE)
		elseif(_lower_library MATCHES "\\.lib$")
			# COFF import archives export an import descriptor in their linker index.
			file(READ "${library}" _header LIMIT 68)
			string(LENGTH "${_header}" _header_length)
			if(NOT _header_length EQUAL 68)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': truncated archive header")
			endif()
			string(SUBSTRING "${_header}" 0 8 _signature)
			string(SUBSTRING "${_header}" 8 16 _member)
			string(SUBSTRING "${_header}" 56 10 _index_size)
			string(SUBSTRING "${_header}" 66 2 _member_end)
			string(STRIP "${_member}" _member)
			string(STRIP "${_index_size}" _index_size)
			if(NOT _signature STREQUAL "!<arch>\n" OR NOT _member STREQUAL "/"
					OR NOT _member_end STREQUAL "`\n" OR NOT _index_size MATCHES "^[0-9]+$")
				message(FATAL_ERROR "Cannot classify Windows library '${library}': expected a COFF archive with a linker index")
			endif()
			file(SIZE "${library}" _library_size)
			math(EXPR _index_end "68 + ${_index_size}")
			if(_index_end GREATER _library_size)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': truncated linker index")
			endif()
			if(_index_size LESS 4)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': truncated linker index symbol count")
			endif()
			file(READ "${library}" _count_hex OFFSET 68 LIMIT 4 HEX)
			math(EXPR _symbol_count "0x${_count_hex}")
			math(EXPR _names_offset "72 + 4 * ${_symbol_count}")
			if(_names_offset GREATER _index_end)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': invalid linker index symbol count")
			endif()
			math(EXPR _names_size "${_index_end} - ${_names_offset}")
			if(_symbol_count GREATER 0 AND _names_size EQUAL 0)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': missing linker index symbol names")
			endif()
			file(READ "${library}" _symbols OFFSET "${_names_offset}" LIMIT "${_names_size}" HEX)
			if(_names_size GREATER 0 AND NOT _symbols MATCHES "00$")
				message(FATAL_ERROR "Cannot classify Windows library '${library}': unterminated linker index symbol names")
			endif()
			get_filename_component(_library_name "${library}" NAME_WLE)
			string(LENGTH "${_library_name}" _name_length)
			if(_name_length EQUAL 0)
				message(FATAL_ERROR "Cannot classify Windows library '${library}': empty library name")
			endif()
			set(_name_pattern "")
			math(EXPR _last_character "${_name_length} - 1")
			foreach(_position RANGE 0 ${_last_character})
				string(SUBSTRING "${_library_name}" ${_position} 1 _character)
				string(TOLOWER "${_character}" _lower_character)
				string(TOUPPER "${_character}" _upper_character)
				string(HEX "${_lower_character}" _lower_hex)
				string(HEX "${_upper_character}" _upper_hex)
				if(_lower_hex STREQUAL _upper_hex)
					string(APPEND _name_pattern "${_lower_hex}")
				else()
					string(SUBSTRING "${_lower_hex}" 0 1 _lower_first)
					string(SUBSTRING "${_upper_hex}" 0 1 _upper_first)
					string(SUBSTRING "${_lower_hex}" 1 1 _last_digit)
					string(APPEND _name_pattern "[${_lower_first}${_upper_first}]${_last_digit}")
				endif()
			endforeach()
			# Match the library's own import descriptor at a symbol boundary.
			string(HEX "__IMPORT_DESCRIPTOR_" _descriptor_hex)
			if(_symbols MATCHES "(^|00)${_descriptor_hex}${_name_pattern}00")
				set(_shared TRUE)
			elseif(_symbols MATCHES "(^|00)${_descriptor_hex}")
				if(_override_variable)
					set(_override_hint "set ${_override_variable}=ON")
				else()
					set(_override_hint "use an explicit shared-library override")
				endif()
				message(WARNING
					"Windows library '${library}' contains import descriptors for other DLLs and is treated as static. "
					"If this is a renamed import library, ${_override_hint}.")
			endif()
		endif()
	endif()
	set(${out} "${_shared}" PARENT_SCOPE)
endfunction()

function(_stormbyte_load_component component)
	set(StormByte_${component}_FOUND FALSE)
	if(TARGET StormByte::${component})
		set(StormByte_${component}_FOUND TRUE PARENT_SCOPE)
		return()
	endif()
	if(component STREQUAL "Base" OR NOT TARGET StormByte)
		set(StormByte_${component}_FOUND FALSE PARENT_SCOPE)
		return()
	endif()
	if(component IN_LIST _STORMBYTE_COMPONENT_STACK)
		message(FATAL_ERROR "StormByte component dependency cycle: ${_STORMBYTE_COMPONENT_STACK};${component}")
	endif()
	list(APPEND _STORMBYTE_COMPONENT_STACK "${component}")

	set(_config "_config-NOTFOUND")
	find_file(_config
		NAMES "FindStormByte${component}.cmake"
		HINTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}" ${CMAKE_MODULE_PATH}
		PATHS ${CMAKE_PREFIX_PATH}
		PATH_SUFFIXES share/cmake/Modules
		NO_CACHE
	)
	if(_config)
		include("${_config}")
	endif()
	set(StormByte_${component}_FOUND "${StormByte_${component}_FOUND}" PARENT_SCOPE)
endfunction()

function(stormbyte_find_component component)
	cmake_parse_arguments(PARSE_ARGV 1 SB "" "" "DEPENDS")
	if(SB_UNPARSED_ARGUMENTS OR SB_KEYWORDS_MISSING_VALUES)
		message(FATAL_ERROR "Invalid stormbyte_find_component(${component}) arguments")
	endif()
	set(StormByte_${component}_FOUND FALSE PARENT_SCOPE)
	if(NOT TARGET StormByte)
		return()
	endif()

	set(_dependencies_found TRUE)
	set(_link_libraries StormByte)
	foreach(_dependency IN LISTS SB_DEPENDS)
		_stormbyte_load_component("${_dependency}")
		if(StormByte_${_dependency}_FOUND)
			list(APPEND _link_libraries StormByte::${_dependency})
		else()
			set(_dependencies_found FALSE)
		endif()
	endforeach()

	string(TOLOWER "${component}" _lower)
	string(TOUPPER "${component}" _upper)
	find_path(STORMBYTE_${component}_INCLUDE_DIR
		NAMES "StormByte/${_lower}/visibility.h" "StormByte/${component}/visibility.h"
		HINTS "${STORMBYTE_INCLUDE_DIR}"
		PATH_SUFFIXES include
	)
	find_library(STORMBYTE_${component}_LIBRARY
		NAMES "StormByte-${component}" "StormByte_${component}" "stormbyte-${_lower}" "stormbyte_${_lower}"
		PATH_SUFFIXES lib lib64
	)
	mark_as_advanced(STORMBYTE_${component}_INCLUDE_DIR STORMBYTE_${component}_LIBRARY)

	if(NOT _dependencies_found OR NOT STORMBYTE_${component}_INCLUDE_DIR OR NOT STORMBYTE_${component}_LIBRARY)
		return()
	endif()

	if(NOT TARGET StormByte-${component})
		add_library(StormByte-${component} UNKNOWN IMPORTED GLOBAL)
		set_target_properties(StormByte-${component} PROPERTIES
			IMPORTED_LOCATION "${STORMBYTE_${component}_LIBRARY}"
			INTERFACE_INCLUDE_DIRECTORIES "${STORMBYTE_${component}_INCLUDE_DIR}"
			INTERFACE_LINK_LIBRARIES "${_link_libraries}"
		)
		_stormbyte_library_is_shared("${STORMBYTE_${component}_LIBRARY}" _shared
			"STORMBYTE_${component}_LIBRARY_IS_SHARED")
		if(_shared)
			target_compile_definitions(StormByte-${component} INTERFACE STORMBYTE_${_upper}_SHARED)
		endif()
	endif()
	if(NOT TARGET StormByte::${component})
		add_library(StormByte::${component} ALIAS StormByte-${component})
	endif()
	set(StormByte_${component}_FOUND TRUE PARENT_SCOPE)
endfunction()
